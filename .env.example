# ===== LLM（OpenAI 兼容协议，中转站/官方均可）=====
# 必填：API Key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 必填：BaseURL，必须带 /v1 结尾（如官方 https://api.openai.com/v1）
LLM_BASE_URL=https://your-gateway.example.com/v1
# 必填：模型名（中转站请填该站支持的模型 id）
LLM_MODEL=gpt-4o-mini

# 可选：超时（毫秒），分镜生成较长，默认 180000
LLM_TIMEOUT_MS=180000

# 可选：推理模型的思考力度（reasoning_effort），minimal/low/medium/high
# 分镜 JSON 任务不需要深思考，默认 minimal（实测单镜 ~120s → ~19s）；填 "" 可显式关闭
LLM_REASONING_EFFORT=minimal

# 可选：该模型是否支持图片输入（vision）。缺省=支持；填 false 表示纯文本模型（如 DeepSeek），
# 上传参考图提取风格时会被前端过滤掉、服务端返回 VISION_UNSUPPORTED
LLM_VISION=true

# 可选：上游限流/故障时的退避重试次数（含首次尝试），默认 3；429/5xx 才重试
LLM_MAX_ATTEMPTS=3
# 可选：退避基数（毫秒），按 2^n 递增并封顶 8s；上游给了 Retry-After 时优先遵循
LLM_RETRY_BASE_MS=800

# 可选：链路日志落盘目录，默认 <项目根>/.data（/logs 页面读取）
# TRACE_LOG_DIR=/tmp/video-flow-traces
