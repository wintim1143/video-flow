# ===== LLM（OpenAI 兼容协议，中转站/官方均可）=====
# 必填：API Key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 必填：BaseURL，必须带 /v1 结尾（如官方 https://api.openai.com/v1）
LLM_BASE_URL=https://your-gateway.example.com/v1
# 必填：模型名（中转站请填该站支持的模型 id）
LLM_MODEL=gpt-4o-mini

# 可选：超时（毫秒），分镜生成较长，默认 180000
LLM_TIMEOUT_MS=180000

# 可选：推理模型的思考力度（reasoning_effort），minimal/low/medium/high
# 分镜 JSON 任务不需要深思考，默认 minimal（实测单镜 ~120s → ~19s）；填 "" 可显式关闭
LLM_REASONING_EFFORT=minimal

# 可选：该模型是否支持图片输入（vision）。缺省=支持；填 false 表示纯文本模型（如 DeepSeek），
# 上传参考图提取风格时会被前端过滤掉、服务端返回 VISION_UNSUPPORTED
LLM_VISION=true

# 可选：上游限流/故障时的退避重试次数（含首次尝试），默认 3；429/5xx 才重试
LLM_MAX_ATTEMPTS=3
# 可选：退避基数（毫秒），按 2^n 递增并封顶 8s；上游给了 Retry-After 时优先遵循
LLM_RETRY_BASE_MS=800

# 可选：链路日志落盘目录，默认 <项目根>/.data（/logs 页面读取）
# TRACE_LOG_DIR=/tmp/video-flow-traces

# ===== 视频生成（异步任务）=====
# 两个闸门量级完全不同，不要混为一谈：生成 1 次/分钟，查询约 3 秒一次。

# 可选：生成（建任务）的最小间隔（毫秒），默认 60000。
# 只有 POST /videos 吃生成配额，且配额是账户级的 —— 生成了 A 镜，B 镜也要等。
# Agnes 限时免费档实测约 1 次/分钟；付费或自建网关可调小，0 = 关闭闸门。
VIDEO_CREATE_MIN_INTERVAL_MS=60000

# 可选：查询的最小间隔（毫秒），默认 4000。
# 上游查询侧是「约 15 次/60s」的宽松限流，与生成配额完全无关：
#   实测 2.0s × 8 次  → 第 4、8 次 429（Retry-After: 2）
#   实测 3.0s × 10 次 → 全 200，但经应用层 3.5s 实测 6 次仍偶发 1 次 429
#   实测 4.0s × 15 次（整 60s）→ 全 200 ✅
# 官方文档建议的 1–2 秒轮询会周期性撞 429；撞上也会按 Retry-After 自动退避，不算失败。
VIDEO_QUERY_MIN_INTERVAL_MS=4000

# 可选：单次视频请求超时（毫秒），默认 300000
VIDEO_TIMEOUT_MS=300000

# ===== 产物归档（R6.1）=====
# 可选：归档根目录，默认 <项目根>/.data/artifacts（已在 .gitignore 内）。
# 「归档到本地」会把成片 mp4、关键帧图与 prompt 落到 <ARTIFACT_DIR>/<YYYYMMDD-HHMMSS>/。
# ARTIFACT_DIR=/tmp/video-flow-artifacts
